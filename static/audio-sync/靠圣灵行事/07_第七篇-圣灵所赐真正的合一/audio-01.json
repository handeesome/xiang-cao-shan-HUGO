    {
      "start": 354.9,
      "end": 454.27,
      "kind": "paragraph",
      "targetIndex": 11,
      "targetText": "惟有基督的灵在基督徒的心思意念中活着内住和工作才产生有内涵的教会所以只有把基督昔目在人面前的言行",
      "confidence": 0.839
