  "cues": [
    {
      "start": 0.08,
      "end": 6.86,
      "kind": "heading",
      "targetIndex": 0,
      "targetText": "第八篇基督借圣灵住在我们里面",
      "confidence": 0.929
    },
    {
      "start": 6.86,
      "end": 12.4,
      "kind": "heading",
      "targetIndex": 1,
      "targetText": "基督藉圣灵住在我们里面博学的上帝学家不信",
      "confidence": 0.872
    },
    {
      "start": 12.4,
      "end": 89.5,
      "kind": "paragraph",
      "targetIndex": 2,
      "targetText": "圣洁的主耶稣说我就常与你们同在直到世界的末了太2820祂怎样与我们同在当然不是一般肉眼能看见外表",
      "confidence": 0.913
