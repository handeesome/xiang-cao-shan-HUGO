    {
      "start": 197.82,
      "end": 267.58,
      "kind": "paragraph",
      "targetIndex": 6,
      "targetText": "保罗说我传福音并不用智慧的言语免得基督的十字架在犹太人为绊脚石在外邦人为愚拙落了空林前11723",
      "confidence": 0.848
    },
    {
      "start": 267.58,
      "end": 270.16,
      "kind": "heading",
      "targetIndex": 7,
      "targetText": "学者迷路",
      "confidence": 0.857
