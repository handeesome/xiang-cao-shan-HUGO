    {
      "start": 258.66,
      "end": 274.72,
      "kind": "paragraph",
      "targetIndex": 5,
      "targetText": "著者用四种最显著的句子以解释律法的不完全同时又指出将来的美事是基督所要给我们的真像和属灵的经历",
      "confidence": 0.894
    },
    {
      "start": 274.72,
      "end": 340.3,
      "kind": "paragraph",
      "targetIndex": 6,
