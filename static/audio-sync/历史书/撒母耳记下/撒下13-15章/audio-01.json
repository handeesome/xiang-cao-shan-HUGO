      "confidence": 0.833
    },
    {
      "start": 226.27,
      "end": 312.62,
      "kind": "paragraph",
      "targetIndex": 6,
      "targetText": "约拿达圣经说他为人极其狡猾他给暗嫩出歪点子后来暗嫩听从了他的点子装病到最后暗嫩死了其实这个约拿达",
      "confidence": 0.903
