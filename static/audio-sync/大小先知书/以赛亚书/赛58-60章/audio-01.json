    {
      "start": 178.24,
      "end": 203.28,
      "kind": "paragraph",
      "targetIndex": 11,
      "targetText": "我们的上帝我们的主是安息日的主主要使我们在他里面尊敬他在他里面不办私事在他里面以他为乐使我们可以",
      "confidence": 0.83
    },
    {
      "start": 203.28,
      "end": 214.56,
      "kind": "paragraph",
      "targetIndex": 13,
      "targetText": "第59章是先知指责百姓的罪恶",
      "confidence": 1.0
