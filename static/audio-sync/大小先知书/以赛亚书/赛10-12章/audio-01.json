      "confidence": 0.8
    },
    {
      "start": 414.16,
      "end": 504.84,
      "kind": "paragraph",
      "targetIndex": 26,
      "targetText": "从耶西的本必发一条从他根生的枝子必结果实耶和华的灵必住在他身上就是使他有智慧和聪明的灵谋略和能力",
      "confidence": 0.865
