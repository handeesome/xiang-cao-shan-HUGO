    {
      "start": 35.04,
      "end": 116.02,
      "kind": "paragraph",
      "targetIndex": 1,
      "targetText": "当我们论述教会时在几种情况下我们用了彰显这个词以此说明属天的观念和本质与实际应用之间的区别后者具",
      "confidence": 0.852
