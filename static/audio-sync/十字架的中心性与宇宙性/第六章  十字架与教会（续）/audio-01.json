    {
      "start": 159.88,
      "end": 160.62,
      "kind": "heading",
      "targetIndex": 3,
      "targetText": "基督的属灵彰显",
      "confidence": 0.6
    },
    {
      "start": 160.62,
      "end": 187.9,
      "kind": "paragraph",
      "targetIndex": 4,
      "targetText": "当我们转来看基督曾是如何以属灵的方式在这里时我们发现那主要是以三种强大能力和冲击力的方式生命光爱",
      "confidence": 0.947
