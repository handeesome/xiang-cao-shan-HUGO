      "targetText": "七",
      "confidence": 1.0
    },
    {
      "start": 1029.53,
      "end": 1036.87,
      "kind": "paragraph",
      "targetIndex": 26,
      "targetText": "教会最真急需的乃是在于那些能为此祝福作见证的人",
      "confidence": 0.913
