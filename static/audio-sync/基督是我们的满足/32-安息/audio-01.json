    {
      "start": 100.22,
      "end": 131.62,
      "kind": "paragraph",
      "targetIndex": 5,
      "targetText": "是主耶稣能给我们的心灵有符久不变的安息但我们的自我估量却是不能信心永不以我们自己里头的情形来作安",
      "confidence": 0.874
    },
    {
      "start": 131.62,
      "end": 136.34,
      "kind": "paragraph",
      "targetIndex": 6,
      "targetText": "我们蒙恩儿女在此走祂道路",
