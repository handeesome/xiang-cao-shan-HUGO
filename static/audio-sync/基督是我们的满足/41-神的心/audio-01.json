      "confidence": 1.0
    },
    {
      "start": 47.74,
      "end": 52.26,
      "kind": "paragraph",
      "targetIndex": 6,
      "targetText": "良善满怜悯超然而上帝圣",
      "confidence": 0.667
    },
    {
      "start": 52.26,
      "end": 56.66,
      "kind": "paragraph",
