    {
      "start": 18.26,
      "end": 19.66,
      "kind": "heading",
      "targetIndex": 3,
      "targetText": "一基督人失败的经历",
      "confidence": 0.667
    },
    {
      "start": 19.66,
      "end": 93.64,
      "kind": "paragraph",
      "targetIndex": 4,
      "targetText": "当我们才得救的时候因着上帝的恩典真是满心欢喜快乐当我们才得救的时候我们对于我们的生命充满了盼望当",
      "confidence": 0.99
