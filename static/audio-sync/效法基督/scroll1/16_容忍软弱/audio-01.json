  "cues": [
    {
      "start": 0.14,
      "end": 5.46,
      "kind": "heading",
      "targetIndex": 0,
      "targetText": "第十六章容忍别人的软弱",
      "confidence": 0.818
    },
    {
      "start": 5.46,
      "end": 16.9,
      "kind": "paragraph",
      "targetIndex": 1,
      "targetText": "一不论在自己或别人身上有非己力所能改正的弱点就要忍耐等候上帝的旨意",
      "confidence": 0.875
    },
    {
      "start": 16.9,
      "end": 37.3,
      "kind": "paragraph",
      "targetIndex": 2,
      "targetText": "要想这些弱点或许对你有更大的益处因为它可以试炼你训练你的耐心若无这些试炼和忍耐我们一切的好行为就",
      "confidence": 0.931
    },
    {
      "start": 37.3,
      "end": 47.86,
      "kind": "paragraph",
      "targetIndex": 3,
      "targetText": "虽然如此你还是应该为这些弱点祷告求上帝赐你助力使你能够乐意地忍受",
      "confidence": 0.844
    },
    {
      "start": 47.86,
      "end": 93.66,
      "kind": "paragraph",
      "targetIndex": 4,
      "targetText": "二若有人经过一两次的警告还不肯改正他的过失就不要再和他争辩却将一切交托给上帝愿他的旨意得以成就他",
      "confidence": 0.933
    },
    {
      "start": 93.66,
      "end": 112.99,
      "kind": "paragraph",
      "targetIndex": 5,
      "targetText": "假如你自己还不能照着自己的意思做人你怎能希望别人在凡事上照着你的意思呢",
      "confidence": 0.711
    },
    {
      "start": 112.99,
      "end": 121.88,
      "kind": "paragraph",
      "targetIndex": 6,
      "targetText": "我们总是责备别人不完全可是我们自己却不改正自己的错误",
      "confidence": 0.923
    },
    {
      "start": 121.88,
      "end": 139.04,
      "kind": "paragraph",
      "targetIndex": 7,
      "targetText": "三我们严格地要别人改正过失我们自己却不肯改我们非难别人溢用自由但是我们却不愿自己的欲望受到阻碍",
      "confidence": 0.915
    },
    {
      "start": 139.04,
      "end": 146.98,
      "kind": "paragraph",
      "targetIndex": 8,
      "targetText": "我们要别人谨守严格的法律但是自己却无论如何不愿意受法律的约束",
      "confidence": 0.772
    },
    {
      "start": 146.98,
      "end": 155.48,
      "kind": "paragraph",
      "targetIndex": 9,
      "targetText": "由此看来我们常常不能把自己和邻人放在同一个天平上来称量",
      "confidence": 0.83
    },
    {
      "start": 155.48,
      "end": 165.16,
      "kind": "paragraph",
      "targetIndex": 10,
      "targetText": "假若一切的人都是完全的还有什么可使我们为主的缘故对邻人容忍呢",
      "confidence": 0.833
    },
    {
      "start": 165.16,
      "end": 204.86,
      "kind": "paragraph",
      "targetIndex": 11,
      "targetText": "四但是现在上帝是这样安排因为我们可以彼此担当重担参加62因为没有一个人是没有过失的没有一个人是没",
      "confidence": 0.65
    },
    {
      "start": 204.86,
      "end": 212.38,
      "kind": "paragraph",
      "targetIndex": 12,
      "targetText": "患难的遭遇是人发现各人德行和力量的最好时刻",
      "confidence": 0.905
    },
    {
      "start": 212.38,
      "end": 218.86,
      "kind": "paragraph",
      "targetIndex": 13,
      "targetText": "因为各种遭遇并不会使太软弱却能显明他的人格",
      "confidence": 0.905
    }
  ]
}
