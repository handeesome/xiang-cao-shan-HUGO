    },
    {
      "start": 357.59,
      "end": 365.37,
      "kind": "paragraph",
      "targetIndex": 24,
      "targetText": "独居退修照料自己是比行上帝迹而忽略了灵魂更好",
      "confidence": 0.727
    },
    {
      "start": 365.37,
      "end": 374.82,
      "kind": "paragraph",
      "targetIndex": 25,
