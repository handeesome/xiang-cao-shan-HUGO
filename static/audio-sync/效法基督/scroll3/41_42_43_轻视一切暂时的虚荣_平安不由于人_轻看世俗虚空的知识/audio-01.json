      "confidence": 0.978
    },
    {
      "start": 59.38,
      "end": 71.71,
      "kind": "paragraph",
      "targetIndex": 5,
      "targetText": "所以羞辱藐视对于我是该得的但是你却该受颂赞尊贵和荣耀",
      "confidence": 0.588
    },
    {
      "start": 71.71,
      "end": 101.4,
      "kind": "paragraph",
      "targetIndex": 6,
